# Forrest's Wallet — operator environment template.
# Copy the VPS section to /srv/forests-wallet/.env on the server (mode 600).
# Copy the Mac sections to ~/.config/forests-wallet/deploy.env and
# ~/.config/forests-wallet/restore.env (mode 600).
#
# NEVER put real secrets in git or chat. Never paste a Hetzner token,
# SSH private key, database password, age private identity, or
# healthchecks URL into chat or git.
#
# This file is placeholders only.

# =============================================================================
# VPS runtime (read by Docker Compose on the server)
# =============================================================================

# Public hostname. Buy a domain before exposing the VPS to the devices.
# Caddy's unattended public ACME is hostname-based (not a bare IP).
DOMAIN=wallet.example.com
ACME_EMAIL=operator@example.com

# Postgres. Compose-internal only; never publish 5432.
POSTGRES_USER=forests
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=forests_wallet
DATABASE_URL=postgres://forests:change-me-to-a-long-random-string@postgres:5432/forests_wallet

# Host bind-mount root for Postgres 18 data. NOT a Compose named volume.
# `docker compose down -v` must not be able to erase this path.
POSTGRES_DATA_DIR=/var/lib/forests-wallet/postgres

# Caddy certificate/config bind mounts (also not named volumes).
CADDY_DATA_DIR=/var/lib/forests-wallet/caddy
CADDY_CONFIG_DIR=/var/lib/forests-wallet/caddy-config

# Image tag written by ops/deploy.sh (git short SHA). Leave as local for first build.
APP_IMAGE_TAG=local

# Application CLI binary inside the app container (PATH).
APP_CLI=fw

# =============================================================================
# VPS backup (ops/backup.sh via cron). age private identity NEVER lives here.
# =============================================================================

# age public recipient only (starts with age1). Private key stays in a
# password manager plus a paper copy at home.
AGE_RECIPIENT=age1examplepublicrecipientxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

BACKUP_LOCAL_DIR=/var/lib/forests-wallet/backups
BACKUP_GIT_DIR=/var/lib/forests-wallet/backup-git
# Separate private git remote — not the application code repository.
BACKUP_GIT_REMOTE=git@github.com:example/forests-wallet-backups.git
# Optional: SSH private key used only for the backup remote (mode 600).
BACKUP_GIT_SSH_KEY=/var/lib/forests-wallet/backup-git-ssh/id_ed25519
BACKUP_RETENTION_DAYS=30
# 1 = gzip the plain-SQL dump before age (recommended). 0 = age the SQL as-is.
BACKUP_COMPRESS=1

# healthchecks.io ping URL. ops/backup.sh pings ONLY after dump+encrypt+push
# all succeed. Do not log this value.
HEALTHCHECKS_URL=https://hc-ping.com/your-uuid-here

# =============================================================================
# Mac deploy (ops/deploy.sh). Does not need the database password.
# =============================================================================

# SSH destination of the VPS. Keys only; no password login.
DEPLOY_SSH=deploy@203.0.113.10
DEPLOY_PATH=/srv/forests-wallet
# Optional path to an SSH private key (mode 600). Prefer ssh-agent instead.
# DEPLOY_SSH_IDENTITY=/Users/operator/.ssh/id_ed25519
# If set, HEAD must match this ref (branch, tag, or SHA) before --apply.
DEPLOY_EXPECTED_REF=main

# =============================================================================
# Mac weekly restore test (ops/restore-test.sh). Never points at production.
# =============================================================================

BACKUP_PULL_DIR=/Users/operator/forests-wallet-backups
# Path to the age private identity file (mode 600). Never copy this to the VPS.
AGE_IDENTITY=/Users/operator/.config/forests-wallet/backup-age.key
