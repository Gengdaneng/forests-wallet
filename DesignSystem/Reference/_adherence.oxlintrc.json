{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/ledger/**",
              "components/money/**",
              "components/navigation/**",
              "ui_kits/**",
              "ui_kits/forrest-ipad/**",
              "ui_kits/parent-iphone/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nunito|Noto Sans SC|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Nunito, Noto Sans SC, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|direction|label|key|ref|className|style|children)$/]",
        "message": "<AmountField> doesn't accept that prop. Declared props: value, direction, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountField'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:in|out|fix)$/]",
        "message": "<AmountField> direction must be one of 'in' | 'out' | 'fix'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountText'] > JSXAttribute > JSXIdentifier[name!=/^(?:cents|direction|size|showSign|style|key|ref|className|style|children)$/]",
        "message": "<AmountText> doesn't accept that prop. Declared props: cents, direction, size, showSign, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountText'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:in|out|fix|debt|flat)$/]",
        "message": "<AmountText> direction must be one of 'in' | 'out' | 'fix' | 'debt' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountText'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|heroSm|row|small)$/]",
        "message": "<AmountText> size must be one of 'hero' | 'heroSm' | 'row' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, size."
