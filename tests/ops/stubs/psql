#!/bin/sh
# Records psql -f invocations for restore-test.sh.
set -eu
log="${FW_PSQL_LOG:-/dev/null}"
echo "psql $*" >>"$log"
file=""
prev=""
for a in "$@"; do
  if [ "$prev" = "-f" ]; then
    file="$a"
  fi
  prev="$a"
done
if [ -z "$file" ] || [ ! -f "$file" ]; then
  echo "psql stub: missing -f file" >&2
  exit 1
fi
if grep -q "PostgreSQL database dump" "$file"; then
  echo "restored-dump" >>"$log"
fi
if grep -q "transaction_rows" "$file"; then
  echo "checked-invariants" >>"$log"
fi
exit 0
